{
  "_comment": "插件面板 ⇄ 控制台功能对照。check-parity.mjs 读它来核对两边是否同步。",
  "_howToAdd": "新增跨端功能时加一条：plugin/console 里的 markers 是『该实现留下的可检索痕迹』；只在一端有意为之的项写 intentional，并说明理由。",
  "features": [
    {
      "name": "账号余额显示",
      "plugin": { "file": "dsh-plugin/lib/client.js", "markers": ["wb-balance-badge"] },
      "console": { "file": "dashboard/public/index.html", "markers": ["acct-balance"] }
    },
    {
      "name": "自动换号开关",
      "plugin": { "file": "dsh-plugin/lib/client.js", "markers": ["wb-auto-switch"] },
      "console": { "file": "dashboard/public/index.html", "markers": ["autoSwitchBox"] }
    },
    {
      "name": "自动换号后端",
      "plugin": { "file": "dsh-plugin/lib/routes.mjs", "markers": ["/workbuddy/auto-switch"] },
      "console": { "file": "dashboard/server.mjs", "markers": ["/api/auto-switch"] }
    },
    {
      "name": "余额批量端点",
      "plugin": { "file": "dsh-plugin/lib/routes.mjs", "markers": ["/workbuddy/quota-all"] },
      "console": { "file": "dashboard/server.mjs", "markers": ["/v1/quota/all"] }
    },
    {
      "name": ".env 读写（共用实现）",
      "plugin": { "file": "dsh-plugin/lib/index.js", "markers": ["env-file.mjs"] },
      "console": { "file": "dashboard/server.mjs", "markers": ["env-file.mjs"] },
      "shared": { "file": "lib/env-file.mjs", "markers": ["export function updateProjectEnv"] }
    },
    {
      "name": "用量上限（按账号分组）",
      "plugin": { "file": "dsh-plugin/lib/client.js", "markers": ["wb-limit-acct"] },
      "console": { "file": "dashboard/public/index.html", "markers": ["limitsBox", "acct-limited"] },
      "shared": { "file": "lib/limits.mjs", "markers": ["export function collectLimitItems", "export function backfillResetTimes"] }
    },
    {
      "name": "用量上限后端",
      "plugin": { "file": "dsh-plugin/lib/routes.mjs", "markers": ["/workbuddy/limits"] },
      "console": { "file": "dashboard/server.mjs", "markers": ["/api/limits", "limitsSnapshot"] }
    },
    {
      "name": "签到（单账号 + 全部领取）",
      "plugin": { "file": "dsh-plugin/lib/client.js", "markers": ["checkin/all", "账号签到状态"] },
      "console": { "file": "dashboard/public/index.html", "markers": ["acctCheckinBox", "全部领取"] }
    },
    {
      "name": "跨账号签到后端",
      "plugin": { "file": "dsh-plugin/lib/routes.mjs", "markers": ["/workbuddy/checkin/all"] },
      "console": { "file": "dashboard/server.mjs", "markers": ["/api/checkin/all"] }
    },
    {
      "name": "模型测速",
      "plugin": { "file": "dsh-plugin/lib/client.js", "markers": ["wb-rail-tps"] },
      "console": { "file": "dashboard/public/index.html", "markers": ["renderTpsCell"] }
    },
    {
      "name": "测速后端",
      "plugin": { "file": "dsh-plugin/lib/routes.mjs", "markers": ["/workbuddy/tps"] },
      "console": { "file": "dashboard/server.mjs", "markers": ["/api/tps"] }
    },
    {
      "name": "隐藏未列出 / 只列免费",
      "plugin": { "file": "dsh-plugin/lib/client.js", "markers": ["wb-rail-filters"] },
      "console": { "file": "dashboard/public/index.html", "markers": ["modelHideUnlisted", "仅未列出", "仅免费"] }
    },
    {
      "name": "模型详情（官方档位 / 思考档位）",
      "plugin": { "file": "dsh-plugin/lib/client.js", "markers": ["官方可选上下文"] },
      "console": { "file": "dashboard/public/index.html", "markers": ["官方可选档位", "思考档位"] }
    },
    {
      "name": "对话测试的采样参数（max_tokens / temperature / 思考强度）",
      "plugin": { "file": "dsh-plugin/lib/client.js", "markers": ["采样温度 0~2；留空 = 上游默认"] },
      "console": { "file": "dashboard/public/index.html", "markers": ["chatMaxTokens", "chatTemperature", "chatEffort", "chatOverrides"] }
    }
  ]
}