{
  "name": "dsh-plugin-workbuddy",
  "version": "1.4.7",
  "private": false,
  "description": "DeepSeek Harness 插件：把本机 WorkBuddy 桌面端已登录的模型原生接进 dsh —— 自动管理本地桥、以 llm 适配器注册 workbuddy 路由、提供工具/命令，并在设置里带一个 WorkBuddy 面板。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "workbuddy",
    "codebuddy",
    "llm-provider"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ianzhyh/workbuddy-to-dsh.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/Ianzhyh/workbuddy-to-dsh/tree/main/dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/Ianzhyh/workbuddy-to-dsh/issues"
  }
}
