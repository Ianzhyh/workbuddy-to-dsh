{
  "name": "workbuddy-to-dsh",
  "version": "1.13.1",
  "private": false,
  "description": "把 WorkBuddy 的模型（桌面端登录或插件内浏览器授权）经本地桥暴露为 OpenAI 兼容接口，供 DeepSeek Harness 或任意 OpenAI 客户端调用。根包即 dsh bundle：dsh「添加插件」填 github:Ianzhyh/workbuddy-to-dsh 可直装；发布到 npm 后也可填 workbuddy-to-dsh。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "./dsh-plugin/lib/index.js",
  "exports": {
    ".": "./dsh-plugin/lib/index.js",
    "./client": "./dsh-plugin/lib/client.js",
    "./cordis.patch.yml": "./dsh-plugin/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bridge/workbuddy-bridge.mjs",
    "bridge/miora-video.mjs",
    "bridge/wait-drain.mjs",
    "bridge/promotions.mjs",
    "bridge/launch.mjs",
    "bridge/start-bridge.cmd",
    "dashboard/server.mjs",
    "dashboard/README.md",
    "dashboard/public/index.html",
    "dashboard/public/style.css",
    "config.mjs",
    "cordis.patch.yml",
    "lib/atrest.mjs",
    "lib/client-connect.mjs",
    "lib/diagnostics.mjs",
    "lib/dsh.mjs",
    "lib/find-dsh.mjs",
    "lib/find-workbuddy.mjs",
    "lib/state.mjs",
    "dsh-plugin/lib",
    "dsh-plugin/scripts",
    "dsh-plugin/vendor",
    "dsh-plugin/cordis.patch.yml",
    "dsh-plugin/README.md",
    "dsh-plugin/package.json",
    "LICENSE",
    "NOTICE.md",
    ".env.example"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "start": "node dashboard/server.mjs",
    "bridge": "node bridge/launch.mjs",
    "connect": "node tools/connect.mjs",
    "doctor": "node tools/doctor.mjs",
    "verify": "node tools/verify-atrest.mjs",
    "test:lib": "node --test \"lib/*.test.mjs\"",
    "test:bridge": "node --test \"bridge/*.test.mjs\"",
    "test:plugin": "node --test \"dsh-plugin/tests/*.test.mjs\"",
    "panel:shot": "node dsh-plugin/tests/panel-render.mjs",
    "preflight": "node dsh-plugin/scripts/preflight.mjs",
    "vendor": "node dsh-plugin/scripts/vendor.mjs",
    "vendor:check": "node dsh-plugin/scripts/vendor.mjs --check",
    "check:pack": "node tools/dev/check-package-files.mjs",
    "verify:standalone": "node dsh-plugin/scripts/verify-standalone.mjs",
    "verify:github": "node dsh-plugin/scripts/verify-github-install.mjs",
    "pack:plugin": "node dsh-plugin/scripts/vendor.mjs && cd dsh-plugin && npm pack",
    "check:types": "tsc --noEmit -p jsconfig.json",
    "lint": "eslint .",
    "release:check": "npm run vendor:check && npm run check:pack && npm run check:types && npm run lint && npm run test:lib && npm run test:bridge && npm run test:plugin && npm run verify:standalone && npm run verify:github",
    "test:ui": "node tools/dev/run-ui-tests.mjs",
    "panel:i18n": "node dsh-plugin/tests/panel-i18n.mjs",
    "panel:check": "node dsh-plugin/tests/panel-render.mjs && node dsh-plugin/tests/panel-i18n.mjs",
    "verify:release": "node tools/dev/verify-release.mjs",
    "publish:npm": "npm run release:check && npm publish --access public",
    "check:i18n": "node tools/dev/check-i18n-coverage.mjs",
    "check:opencode": "node tools/check-opencode-config.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "workbuddy",
    "codebuddy",
    "llm-provider",
    "openai-compatible",
    "local-bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ianzhyh/workbuddy-to-dsh.git"
  },
  "homepage": "https://github.com/Ianzhyh/workbuddy-to-dsh#readme",
  "bugs": {
    "url": "https://github.com/Ianzhyh/workbuddy-to-dsh/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}
